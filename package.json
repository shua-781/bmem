{
  "name": "bmem",
  "version": "0.1.0",
  "description": "Long-term memory for AI agents: append-only event log + block library + graded retrieval. Not RAG, not summarization.",
  "license": "MIT",
  "type": "module",
  "main": "./src/read.js",
  "bin": {
    "bmem": "./src/cli.mjs"
  },
  "exports": {
    ".": "./src/read.js",
    "./store": "./src/store.js",
    "./write": "./src/write.js",
    "./read": "./src/read.js",
    "./cli": "./src/cli.mjs"
  },
  "files": [
    "src/",
    "README.md",
    "QUICKSTART.md",
    "QUICKSTART-纯文本.txt",
    "INSTALL-BY-AI.txt",
    "LICENSE",
    "DISCLAIMER.md"
  ],
  "scripts": {
    "test": "node src/selftest.mjs",
    "init": "node src/cli.mjs init",
    "stats": "node src/cli.mjs stats"
  },
  "keywords": [
    "ai",
    "memory",
    "llm",
    "agent",
    "long-term-memory",
    "dsh",
    "mcp"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/bmem.git"
  },
