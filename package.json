{
  "name": "beme",
  "version": "0.1.5",
  "description": "Long-term memory for AI agents: append-only event log + block library + AI-segmented chunks + graded retrieval. Not RAG, not summarization.",
  "license": "MIT",
  "type": "module",
  "main": "./dsh/index.mjs",
  "bin": {
    "beme": "./src/cli.mjs"
  },
  "exports": {
    ".": "./dsh/index.mjs",
    "./store": "./src/store.js",
    "./write": "./src/write.js",
    "./read": "./src/read.js",
    "./cli": "./src/cli.mjs",
    "./dsh": "./dsh/index.mjs",
    "./plugin": "./dsh/index.mjs"
  },
  "files": [
    "src/",
    "README.md",
    "QUICKSTART.md",
    "QUICKSTART-纯文本.txt",
    "INSTALL-BY-AI.txt",
    "LICENSE",
    "DISCLAIMER.md",
    "dsh"
  ],
  "scripts": {
    "test": "node src/selftest.mjs",
    "init": "node src/cli.mjs init",
    "stats": "node src/cli.mjs stats"
  },
  "keywords": [
    "ai",
    "memory",
    "llm",
    "agent",
    "long-term-memory",
    "dsh",
    "mcp",
    "chunking",
    "ai-memory"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shua-781/beme.git"
  },
  "author": "彼方业火狐",
  "private": false,
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*"
  }
}